# Copy to .env and change secrets. Never commit .env.

YII_ENV=dev
YII_DEBUG=1
COOKIE_VALIDATION_KEY=change-me-random-32-chars

APP_PORT=8080
# Test stand for smoke/UI/E2E tests (make test-up), DB app_test
APP_TEST_PORT=8081
# Lifetime of WebSocket tokens on the test stand, seconds (E2E test E-09 waits for it)
CENTRIFUGO_TEST_TOKEN_TTL=5
MYSQL_PORT=3307

MYSQL_ROOT_PASSWORD=root-secret
DB_HOST=mysql
DB_NAME=app
DB_TEST_NAME=app_test
# DB user must stay "app": docker/mysql/init grants it access to app_test
DB_USER=app
DB_PASSWORD=app-secret

# Anti-spam: max comments one IP may post per minute
COMMENT_RATE_LIMIT_PER_MINUTE=5

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Centrifugo (WebSockets). Browsers connect via nginx: ws://localhost:${APP_PORT}/connection/websocket
# Port for direct access (debugging only)
CENTRIFUGO_PORT=8000
# PHP publishes events here (inside the Docker network)
CENTRIFUGO_API_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=change-me-api-key
# Signs the JWTs that Yii gives to logged-in admins
CENTRIFUGO_TOKEN_SECRET=change-me-token-secret
# Lifetime of those JWTs, seconds: after logout, other open admin tabs stop receiving comments within it
CENTRIFUGO_TOKEN_TTL=3600
# Must match the address you open the app with (scheme + host + APP_PORT), space-separated if several
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:8080

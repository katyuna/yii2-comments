parameters:
    level: 6

    paths:
        - assets
        - commands
        - migrations
        - services
        - config
        - controllers
        - models
        - modules
        - widgets

    excludePaths:
        - config/__autocomplete.php

    scanDirectories:
        - tests/Support

    scanFiles:
        # Tells PHPStan which components Yii::$app has (user, db, ...)
        - config/__autocomplete.php

    bootstrapFiles:
        - tests/_bootstrap.php

    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    tmpDir: %currentWorkingDirectory%/runtime/phpstan

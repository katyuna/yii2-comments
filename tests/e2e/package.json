{
  "name": "yii2-comments-e2e",
  "private": true,
  "description": "UI and E2E tests for Yii2 Comments (Playwright)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:e2e": "playwright test --project=e2e-chromium --project=e2e-firefox --project=e2e-webkit",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "fix": "eslint . --fix && prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.49.1",
    "@types/node": "^22.20.6",
    "eslint": "^9.39.5",
    "eslint-plugin-playwright": "^2.12.2",
    "mysql2": "^3.24.6",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
